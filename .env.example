# Formulário de contato (src/app/api/contato/route.ts) — envio via Resend.
# Copie para .env.local e preencha. Na Vercel: Project → Settings → Environment Variables.

# Chave da API: https://resend.com/api-keys
RESEND_API_KEY=

# Quem recebe as solicitações de diagnóstico.
CONTACT_TO_EMAIL=

# Remetente. Opcional: sem domínio verificado no Resend, deixe em branco
# (usa onboarding@resend.dev, que só entrega ao e-mail dono da conta Resend).
# Com domínio verificado: "Site Geoforte <contato@geoforte.com.br>"
CONTACT_FROM_EMAIL=

# Opcional. Na Vercel o endereço do site já vem de VERCEL_PROJECT_PRODUCTION_URL;
# defina esta só para forçar outro (ex.: https://www.geoforte.com.br).
NEXT_PUBLIC_SITE_URL=
